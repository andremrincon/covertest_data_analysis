package ts01qwen3_7_plus;

import org.junit.BeforeClass;
import org.junit.Test;
import io.restassured.RestAssured;
import io.restassured.parsing.Parser;
import static io.restassured.RestAssured.given;
import static org.hamcrest.Matchers.equalTo;
import static org.hamcrest.Matchers.lessThan;

public class LanguageTest {

    private static final String BASE_URI = "http://localhost:8080/rest";

    @BeforeClass
    public static void init() {
        RestAssured.defaultParser(Parser.JSON);
    }

    @Test(timeout = 60000)
    public void testSetIso639_1() {
        given()
            .baseUri(BASE_URI)
            .when()
                .get("/v1/alpha/US")
            .then()
                .statusCode(200)
                .body("languages[0].iso639_1", equalTo("en"));
    }

    @Test(timeout = 60000)
    public void testSetIso639_2() {
        given()
            .baseUri(BASE_URI)
            .when()
                .get("/v1/alpha/US")
            .then()
                .statusCode(200)
                .body("languages[0].iso639_2", equalTo("eng"));
    }

    @Test(timeout = 60000)
    public void testSetName() {
        given()
            .baseUri(BASE_URI)
            .when()
                .get("/v1/alpha/US")
            .then()
                .statusCode(200)
                .body("languages[0].name", equalTo("English"));
    }

    @Test(timeout = 60000)
    public void testSetNativeName() {
        given()
            .baseUri(BASE_URI)
            .when()
                .get("/v1/alpha/US")
            .then()
                .statusCode(200)
                .body("languages[0].nativeName", equalTo("English"));
    }
}