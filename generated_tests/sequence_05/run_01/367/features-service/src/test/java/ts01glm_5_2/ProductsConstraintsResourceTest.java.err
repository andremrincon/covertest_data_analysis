package ts01glm_5_2;

import org.junit.Before;
import org.junit.Test;

import java.util.HashMap;
import java.util.HashSet;
import java.util.Map;
import java.util.Set;
import java.util.UUID;

public class ProductsConstraintsResourceTest {

    @Before
    public void setUp() {
        RestAssured.baseURI = System.getProperty("baseUrl", "http://localhost:8080");
        RestAssuredServer.reset();
    }

    @Test(timeout = 60000)
    public void addRequiresConstraintSuccess() {
        String productName = "test-req-success-" + UUID.randomUUID().toString();
        String sourceFeature = "src-feat-" + UUID.randomUUID().toString();
        String requiredFeature = "req-feat-" + UUID.randomUUID().toString();

        RestAssured.given().when().post("/products/" + productName).then().statusCodeLessThan(300);
        RestAssured.given().when().post("/products/" + productName + "/features/" + sourceFeature).then().statusCodeLessThan(300);
        RestAssured.given().when().post("/products/" + productName + "/features/" + requiredFeature).then().statusCodeLessThan(300);

        RestAssured.given()
            .contentType(ContentType.URLENC)
            .formParam("sourceFeature", sourceFeature)
            .formParam("requiredFeature", requiredFeature)
        .when()
            .post("/products/" + productName + "/constraints/requires")
        .then()
            .statusCode(201);
    }

    @Test(timeout = 60000)
    public void addExcludesConstraintSuccess() {
        String productName = "test-exc-success-" + UUID.randomUUID().toString();
        String sourceFeature = "src-feat-" + UUID.randomUUID().toString();
        String excludedFeature = "exc-feat-" + UUID.randomUUID().toString();

        RestAssured.given().when().post("/products/" + productName).then().statusCodeLessThan(300);
        RestAssured.given().when().post("/products/" + productName + "/features/" + sourceFeature).then().statusCodeLessThan(300);
        RestAssured.given().when().post("/products/" + productName + "/features/" + excludedFeature).then().statusCodeLessThan(300);

        RestAssured.given()
            .contentType(ContentType.URLENC)
            .formParam("sourceFeature", sourceFeature)
            .formParam("excludedFeature", excludedFeature)
        .when()
            .post("/products/" + productName + "/constraints/excludes")
        .then()
            .statusCode(201);
    }

    @Test(timeout = 60000)
    public void addRequiresConstraintNonExistentProduct() {
        String productName = "non-existent-product-" + UUID.randomUUID().toString();
        String sourceFeature = "src-feat-" + UUID.randomUUID().toString();
        String requiredFeature = "req-feat-" + UUID.randomUUID().toString();

        RestAssured.given()
            .contentType(ContentType.URLENC)
            .formParam("sourceFeature", sourceFeature)
            .formParam("requiredFeature", requiredFeature)
        .when()
            .post("/products/" + productName + "/constraints/requires")
        .then()
            .statusCode(500);
    }

    @Test(timeout = 60000)
    public void addExcludesConstraintNonExistentProduct() {
        String productName = "non-existent-product-" + UUID.randomUUID().toString();
        String sourceFeature = "src-feat-" + UUID.randomUUID().toString();
        String excludedFeature = "exc-feat-" + UUID.randomUUID().toString();

        RestAssured.given()
            .contentType(ContentType.URLENC)
            .formParam("sourceFeature", sourceFeature)
            .formParam("excludedFeature", excludedFeature)
        .when()
            .post("/products/" + productName + "/constraints/excludes")
        .then()
            .statusCode(500);
    }

    @Test(timeout = 60000)
    public void addRequiresConstraintNonExistentFeature() {
        String productName = "test-req-feat-err-" + UUID.randomUUID().toString();
        String sourceFeature = "existing-feat-" + UUID.randomUUID().toString();
        String requiredFeature = "non-existent-feat-" + UUID.randomUUID().toString();

        RestAssured.given().when().post("/products/" + productName).then().statusCodeLessThan(300);
        RestAssured.given().when().post("/products/" + productName + "/features/" + sourceFeature).then().statusCodeLessThan(300);

        RestAssured.given()
            .contentType(ContentType.URLENC)
            .formParam("sourceFeature", sourceFeature)
            .formParam("requiredFeature", requiredFeature)
        .when()
            .post("/products/" + productName + "/constraints/requires")
        .then()
            .statusCode(500);
    }

    @Test(timeout = 60000)
    public void addExcludesConstraintNonExistentFeature() {
        String productName = "test-exc-feat-err-" + UUID.randomUUID().toString();
        String sourceFeature = "existing-feat-" + UUID.randomUUID().toString();
        String excludedFeature = "non-existent-feat-" + UUID.randomUUID().toString();

        RestAssured.given().when().post("/products/" + productName).then().statusCodeLessThan(300);
        RestAssured.given().when().post("/products/" + productName + "/features/" + sourceFeature).then().statusCodeLessThan(300);

        RestAssured.given()
            .contentType(ContentType.URLENC)
            .formParam("sourceFeature", sourceFeature)
            .formParam("excludedFeature", excludedFeature)
        .when()
            .post("/products/" + productName + "/constraints/excludes")
        .then()
            .statusCode(500);
    }
}